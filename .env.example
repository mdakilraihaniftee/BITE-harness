# Copy to .env. Run `source scripts/env.sh` before using the Python API/router.
MODEL_BASE_URL=http://127.0.0.1:8222/v1
MODEL_API_KEY=empty
AUXILIARY_MODEL_BASE_URL=http://127.0.0.1:8222/v1
AUXILIARY_MODEL_API_KEY=empty
JUDGE_MODEL=Qwen/Qwen3-VL-8B-Instruct
JUDGE_API_BASE=http://127.0.0.1:8222/v1/chat/completions
JUDGE_API_KEY=empty
TOOL_SERVER_URL=http://127.0.0.1:8101
SAM3_SERVER_URL=http://127.0.0.1:8086
OCR_SERVER_URL=http://127.0.0.1:8085
DEPTH_ESTIMATION_SERVER_URL=http://127.0.0.1:8087
LMUData=${PWD}/data
HF_HOME=${PWD}/.cache/huggingface
TORCH_HOME=${PWD}/.cache/torch
MPLCONFIGDIR=${PWD}/.cache/matplotlib
VLLM_CACHE_ROOT=${PWD}/.cache/vllm
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=8
HF_HUB_DISABLE_XET=1
# Four-GPU deployment: Qwen on 0,1; depth on 2; OCR and SAM3 on 3.
QWEN_GPUS=0,1
DEPTH_GPUS=2
OCR_GPUS=3
SAM3_GPUS=3
QWEN_CONTEXT_LENGTH=168000
AGENT_CONFIG=configs/local_qwen.yaml
# Optional passive evidence/provenance capture; this does not control tool use.
BITE_OBSERVER_ENABLED=false
BITE_OBSERVER_REFERENCE_BUDGET=15
# Required for the three search capabilities in the full paper preset:
# SERPER_API_KEY=...
# Optional You.com web search / Contents backend:
# YDC_API_KEY=...
# YDC_API_KEY_FILE=/path/to/youcom-key
# IMAGE_UPLOAD_PROVIDER=local
# IMAGE_UPLOAD_PUBLIC_BASE_URL=https://your-public-image-host
# IMAGE_UPLOAD_LOCAL_DIR=${PWD}/.cache/image-host
# Set HF_TOKEN if your account has access to the gated facebook/sam3 checkpoint.
