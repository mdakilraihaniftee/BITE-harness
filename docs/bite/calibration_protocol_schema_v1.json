{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action_paths": {
      "minItems": 1,
      "type": "array"
    },
    "budget": {
      "type": "object"
    },
    "failure_policy": {
      "type": "object"
    },
    "initial_state": {
      "type": "object"
    },
    "model_identity": {
      "type": "object"
    },
    "original_task": {
      "type": "object"
    },
    "persistence": {
      "type": "object"
    },
    "phase_boundary": {
      "const": "Do not start Phase 4B-2B or fit probabilities under this task."
    },
    "resource_plan": {
      "type": "object"
    },
    "sampling": {
      "type": "object"
    },
    "schema_version": {
      "const": "bite.calibration_protocol.v1"
    },
    "selection_design": {
      "type": "object"
    },
    "status": {
      "enum": [
        "FROZEN_SOURCE_PENDING",
        "FROZEN_READY"
      ]
    },
    "tasks": {
      "required": [
        "candidate_verification",
        "object_discovery"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "status",
    "original_task",
    "tasks",
    "sampling",
    "initial_state",
    "action_paths",
    "budget",
    "failure_policy",
    "selection_design",
    "model_identity",
    "persistence",
    "resource_plan",
    "phase_boundary"
  ],
  "type": "object"
}
