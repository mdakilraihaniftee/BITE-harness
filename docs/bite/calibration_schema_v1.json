{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partition",
    "record_id",
    "run_id",
    "question_id",
    "sample_id",
    "state_id",
    "branch_id",
    "source_group_id",
    "joint_observation_id",
    "runtime_features",
    "action",
    "outcome",
    "offline_labels",
    "evidence",
    "matching_protocol"
  ],
  "properties": {
    "schema_version": {
      "const": "bite.calibration.v1"
    },
    "partition": {
      "enum": [
        "development_debug",
        "calibration_fit",
        "calibration_validation",
        "internal_test",
        "final_evaluation"
      ]
    },
    "record_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "question_id": {
      "type": "string"
    },
    "state_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "source_group_id": {
      "type": "string"
    },
    "joint_observation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sample_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "association",
        "preceding_candidate_ids",
        "prior_outcomes",
        "context"
      ],
      "properties": {
        "candidate": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "bite.candidate.v1"
            },
            "candidate_id": {
              "type": "string"
            },
            "sample_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "class_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_observation_id": {
              "type": "string"
            },
            "source_detection_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "bbox_local_xyxy": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "bbox_root_xyxy": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "bbox_root_reported_xyxy": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "frame_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "root_image_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_image_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_group_id": {
              "type": "string"
            },
            "source_image_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_backend": {
              "type": [
                "string",
                "null"
              ]
            },
            "raw_scores": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "mask_ref": {
              "type": [
                "object",
                "null"
              ]
            },
            "candidate_origin": {
              "type": "string"
            },
            "association_status": {
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "candidate_id",
            "sample_id",
            "class_name",
            "source_observation_id",
            "source_detection_ids",
            "bbox_local_xyxy",
            "bbox_root_xyxy",
            "bbox_root_reported_xyxy",
            "frame_reason",
            "root_image_id",
            "resolved_image_id",
            "source_group_id",
            "source_image_sha256",
            "source_backend",
            "raw_scores",
            "mask_ref",
            "candidate_origin",
            "association_status"
          ]
        },
        "association": {
          "type": [
            "object",
            "null"
          ]
        },
        "preceding_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prior_outcomes": {
          "type": "array"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "relative_box_area": {
              "type": [
                "number",
                "null"
              ]
            },
            "retained_score": {
              "type": [
                "number",
                "null"
              ]
            },
            "preceding_proposals": {
              "type": "integer",
              "minimum": 0
            },
            "action_frame": {
              "enum": [
                "root",
                "crop",
                "unknown"
              ]
            },
            "shared_backend": {
              "type": "boolean"
            },
            "remaining_reference_budget_before_action": {
              "type": [
                "integer",
                "null"
              ]
            },
            "frame_valid": {
              "type": "boolean"
            },
            "root_dimensions_width_height": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "known_overlapping_preceding_proposals": {
              "type": "integer",
              "minimum": 0
            },
            "uncomparable_preceding_proposals": {
              "type": "integer",
              "minimum": 0
            },
            "state_completeness": {
              "enum": [
                "observer_projection_not_full_model_or_memory_state",
                "tool_execution_complete_snapshot"
              ]
            },
            "source_image_sha256": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "class_name",
            "relative_box_area",
            "retained_score",
            "preceding_proposals",
            "action_frame",
            "shared_backend",
            "remaining_reference_budget_before_action",
            "frame_valid",
            "root_dimensions_width_height",
            "known_overlapping_preceding_proposals",
            "uncomparable_preceding_proposals",
            "state_completeness",
            "source_image_sha256"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "capability",
        "backend",
        "logical_action_id",
        "provider_tool_call_id",
        "arguments",
        "executed",
        "prior_state_id",
        "selection_probability",
        "selection_probability_reason",
        "logical_tool_cost",
        "latency_ms",
        "physical_attempts",
        "physical_attempts_reason",
        "provenance_event_id",
        "sampling_design",
        "selection_seed",
        "resolved_image_id",
        "cost_accounting_id"
      ],
      "properties": {
        "name": {
          "enum": [
            "root_grounding",
            "repeated_grounding",
            "crop_generation",
            "focused_grounding",
            "alternative_backend_verification",
            null
          ]
        },
        "capability": {
          "type": "string"
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "logical_action_id": {
          "type": "string"
        },
        "provider_tool_call_id": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "executed": {
          "type": "boolean"
        },
        "prior_state_id": {
          "type": "string"
        },
        "selection_probability": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "selection_probability_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "logical_tool_cost": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "physical_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "physical_attempts_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampling_design": {
          "type": "string"
        },
        "selection_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "resolved_image_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_accounting_id": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "category",
        "reason",
        "failure_subtype"
      ],
      "properties": {
        "observed": {
          "type": "boolean"
        },
        "category": {
          "enum": [
            "ambiguous_association",
            "conflicting_candidate",
            "crop_artifact_unavailable",
            "crop_created",
            "crop_geometry_unavailable",
            "duplicate_existing_candidate",
            "execution_failure",
            "invalid_or_unavailable_observation",
            "new_distinct_candidate",
            "no_detection",
            null
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_subtype": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "offline_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "reason",
        "ground_truth_provenance"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "iou_threshold",
              "geometric_valid",
              "official_tp",
              "novel_gt_instance",
              "matching_status"
            ],
            "properties": {
              "iou_threshold": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "max_eligible_iou": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "bbox_raw_root_xyxy": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "bbox_for_matching_xyxy": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "geometric_valid": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "official_tp": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "novel_gt_instance": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "duplicate_gt_evidence": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "class_compatible": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "unmatched_eligible_gt": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "validity_label_usable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "official_ignored": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "official_unmatched": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "best_eligible_gt_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "official_matched_gt_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "ground_truth_provenance": {
          "type": "object"
        }
      }
    },
    "evidence": {
      "type": "object"
    },
    "matching_protocol": {
      "type": "object"
    }
  }
}
