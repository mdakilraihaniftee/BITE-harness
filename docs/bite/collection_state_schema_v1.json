{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "state_digest",
    "snapshot_completeness",
    "task",
    "source_group_id",
    "source_image_sha256",
    "prefix_action_count",
    "prefix_logical_cost",
    "allowed_action_types",
    "memory",
    "execution_context",
    "previous_actions",
    "previous_observations",
    "candidate_history",
    "provenance",
    "native_history",
    "history_mode",
    "capture_complete",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "bite.collection_state.v1"
    },
    "snapshot_id": {
      "type": "string"
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_completeness": {
      "enum": [
        "tool_execution_complete",
        "incomplete"
      ]
    },
    "task": {
      "type": "object"
    },
    "source_group_id": {
      "type": "string"
    },
    "source_image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefix_action_count": {
      "type": "integer",
      "minimum": 0
    },
    "prefix_logical_cost": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_action_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "type": "object"
    },
    "execution_context": {
      "type": "object"
    },
    "previous_actions": {
      "type": "array"
    },
    "previous_observations": {
      "type": "array"
    },
    "candidate_history": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    },
    "native_history": {
      "type": [
        "array",
        "null"
      ]
    },
    "history_mode": {
      "enum": [
        "preserved_not_extended",
        "unavailable"
      ]
    },
    "capture_complete": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
